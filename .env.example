# Copy this file to .env (same folder as docker-compose.yml) and edit the values there.
# .env is read by `docker compose` itself, not by Pointify — it only fills in the
# ${...} placeholders in docker-compose.yml, so there's nothing else to configure.

# Where Pointify stores its data (SQLite database).
# A plain host folder, not a Docker-managed volume, so it's easy to find and back up.
POINTIFY_DATA_LOCATION=./data

# The port Pointify is reachable on from outside the container.
POINTIFY_PORT=8000

# Which published image tag to run. "latest" tracks the newest release; pin it to a
# specific version (e.g. v0.1.0) to control upgrades yourself.
POINTIFY_VERSION=latest

# Required. Secures session cookies — the app refuses to start without this set.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
POINTIFY_SECRET_KEY=
